{
  "appId": "com.chailin.homestock",
  "appName": "悦家库存",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#FFF4E6",
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "launchAutoHide": true,
      "backgroundColor": "#FFF4E6",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": false,
      "splashImmersive": false
    }
  }
}
