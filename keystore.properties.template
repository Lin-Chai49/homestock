# Copy this file to "keystore.properties" (no .template suffix) and fill in your values.
# The keystore.properties file is ignored by git — never commit your real keystore credentials.
#
# To create your keystore (do this once and back it up safely — losing it means you cannot
# publish updates to your existing Play Store app):
#
#   keytool -genkeypair -v -storetype JKS -keystore release.jks \
#     -alias homestock -keyalg RSA -keysize 2048 -validity 36500
#
# Place the resulting release.jks file at: android/app/release.jks
# Then fill in the values below and save as "keystore.properties" (in this project root).

storeFile=../app/release.jks
storePassword=YOUR_STORE_PASSWORD_HERE
keyAlias=homestock
keyPassword=YOUR_KEY_PASSWORD_HERE
